# ---------------------------------------------------------------
# Copie para .env e preencha.  (copy .env.example .env)
# ---------------------------------------------------------------

# MySQL 8+ (necessário para o worker / dashboard; o test:pipeline roda sem banco)
DATABASE_URL="mysql://root:senha@localhost:3306/cortes"

# Chave do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Modelo usado na curadoria e nas legendas.
# gemini-2.5-flash tinha desligamento marcado para 16/10/2026; o substituto indicado pelo Google é o gemini-3.5-flash.
GEMINI_MODEL="gemini-3.5-flash"

# --- Opcionais -------------------------------------------------
# Caminhos dos binários, se não estiverem no PATH
# YTDLP_PATH="C:\\tools\\yt-dlp.exe"
# FFMPEG_PATH="C:\\ffmpeg\\bin\\ffmpeg.exe"
# FFPROBE_PATH="C:\\ffmpeg\\bin\\ffprobe.exe"

# Usar cookies do navegador no yt-dlp (vídeos com restrição de idade / membros) — só no PC
# YTDLP_COOKIES_FROM_BROWSER="chrome"
# No servidor: URL do serviço bgutil-ytdlp-pot-provider (PO Token), ex: http://mohammed_pot:4416
# YTDLP_POT_PROVIDER_URL="http://127.0.0.1:4416"
# Alternativa: arquivo cookies.txt exportado do navegador (quando o YouTube bloquear o IP do servidor)
# YTDLP_COOKIES_FILE="/app/storage/cookies.txt"

# Como buscar o vídeo: "stream" (padrão) puxa só o áudio para a IA e depois só os trechos dos cortes;
# "full" baixa o vídeo inteiro antes (mais lento, use só se o stream der problema em algum site)
# DOWNLOAD_MODE="stream"

# Pastas de trabalho (relativas à raiz do projeto).
# Os cortes ficam FORA de /public: são servidos por /api/media só para o dono do projeto.
JOBS_DIR="tmp/jobs"
OUTPUTS_DIR="storage/outputs"

# Legendas
CAPTION_FONT="Arial Black"
CAPTION_FONT_SIZE="86"
CAPTION_COLOR="#FFFFFF"
CAPTION_HIGHLIGHT_COLOR="#FFD400"
CAPTION_BOLD="1"

# Encoder (H.264)
X264_PRESET="veryfast"
X264_CRF="20"

# Cortes automáticos de live (Twitch): crie um app grátis em https://dev.twitch.tv/console
# (OAuth Redirect URL: http://localhost — não é usada; Categoria: Application Integration)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Worker
# Projetos processados ao mesmo tempo. Render 1080p pesa CPU: 2 para servidor pequeno/compartilhado, 3-4 se sobrar CPU.
WORKER_CONCURRENCY="2"
WORKER_POLL_MS="3000"
WORKER_STALE_MINUTES="30"
