// Prisma 6 + MySQL 8
// Aplicar no banco:  npm run db:push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Estados do job. A ordem reflete o pipeline mostrado no dashboard.
enum JobStatus {
  QUEUED
  DOWNLOADING
  ANALYZING
  RENDERING
  COMPLETED
  FAILED
}

enum LayoutPreset {
  SPLIT  // webcam no topo + gameplay embaixo
  CENTER // tela cheia, crop central 9:16
  BLUR   // vídeo 16:9 centralizado sobre fundo desfocado
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(255)
  name         String    @db.VarChar(120)
  /// scrypt$N$r$p$salt$hash (ver src/lib/auth/password.ts)
  passwordHash String    @db.VarChar(255)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
  sessions     Session[]
}

/// Sessão de login. O cookie guarda um token aleatório; aqui fica só o SHA-256 dele.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(64)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?  @db.VarChar(255)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Um Project é ao mesmo tempo o pedido do usuário e o job da fila.
/// A fila é o próprio MySQL: o worker "reivindica" linhas QUEUED com update otimista.
model Project {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Entrada
  sourceUrl      String       @db.VarChar(2048)
  layoutPreset   LayoutPreset @default(SPLIT)
  /// { webcam?: {x,y,w,h}, gameplay?: {x,y,w,h}, camHeightRatio?: number } — frações 0..1 do frame original.
  /// Sem webcam = a IA detecta a câmera em cada corte.
  layoutConfig   Json?
  minClipSeconds Int          @default(30)
  maxClipSeconds Int          @default(60)
  clipCount      Int          @default(5)
  language       String       @default("pt-BR") @db.VarChar(16)
  /// Trecho opcional a processar, ex: "1:00:00-1:30:00" (lives longas)
  section        String?      @db.VarChar(32)
  /// O que a IA deve procurar: ids separados por vírgula (risadas,hype,...). Vazio = automático.
  focus          String       @default("") @db.VarChar(100)
  /// Pedido livre do usuário sobre quais momentos escolher (máx. 300 caracteres)
  instructions   String?      @db.VarChar(320)

  // Metadados da fonte
  sourceTitle    String? @db.VarChar(512)
  /// Canal/streamer de origem (crédito nos posts)
  sourceCreator  String? @db.VarChar(255)
  sourceDuration Float?

  // Estado do job
  status        JobStatus @default(QUEUED)
  progress      Int       @default(0) // 0..100
  statusMessage String?   @db.VarChar(512)
  error         String?   @db.Text
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  lockedBy      String?   @db.VarChar(128)
  lockedAt      DateTime? // também serve de heartbeat
  startedAt     DateTime?
  finishedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clips Clip[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Clip {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  position   Int    // 1..N, na ordem de viral_score
  startTime  Float  // segundos no vídeo original
  endTime    Float
  viralScore Int
  hookTitle  String @db.VarChar(255)
  hashtags   Json   // string[]
  reason     String @db.Text
  captions   Json   // CaptionBlock[] (offsets relativos ao início do clipe)
  layout     Json?  // LayoutOptions efetivamente usado (com a webcam detectada)
  webcamMode String? @db.VarChar(32) // auto | manual | default | no-webcam | fullscreen-cam | fixed
  post       Json?  // PostPackage: títulos + textos por rede (src/lib/post.ts)

  videoPath     String  @db.VarChar(1024) // URL pública, ex: /outputs/{jobId}/clip_01.mp4
  thumbnailPath String? @db.VarChar(1024)

  createdAt DateTime @default(now())

  @@unique([projectId, position])
}
